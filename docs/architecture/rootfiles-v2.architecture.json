  "cards": [
    {
      "dot": "cyan",
      "title": "Check and apply",
      "items": [
        "13 modules in a fixed defaultOrder; RunAll runs Check then Apply and records each outcome",
        "check, status and doctor use an always-dry-run Runner; check and doctor exit 2 on drift or findings",
        "5 embedded profiles (minimal, base, full, gpu-server, dgx), tree-merged with extends and strict keys"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety model",
      "items": [
        "Mutating commands need root and a non-blocking flock on /run/rootfiles.lock; dry runs are exempt",
        "Real mutating runs log JSON to /var/log/rootfiles.log; files the Runner writes, renames or removes are backed up first, commands it runs are not",
        "rollback restores only those Runner backups; the update binary swap, the GPU db rename, packages, users and services are not reverted",
        "--force overrides guards such as SSH lockout protection"
      ]
    },
    {
      "dot": "violet",
      "title": "Direct operations",
      "items": [
        "<home-base>/.rootfiles/users.json records user add, key and quota changes and drops the entry on del; lock, expire and rehome are not recorded",
        "gpu assign and revoke update gpu-allocations.json under flock with an atomic rename; gpu mig status is read-only",
        "tunnel setup installs the cloudflared service and systemd VLAN units; the cloudflared module also converges them on apply"
      ]
    },
    {
      "dot": "emerald",
      "title": "Reports and updates",
      "items": [
        "schedule enable installs rootfiles-check.timer, which writes check.json and doctor.json to the state dir",
        "check and doctor also emit Prometheus text for the node_exporter textfile collector",
        "update replaces the binary with a GitHub release after verifying checksums.txt; cloudflared binaries also come from GitHub releases"
      ]
    }
  ]
